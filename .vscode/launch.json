{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch Vulkan App",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/vulkan_app", 
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { 
                    "name": "VK_INSTANCE_LAYERS", 
                    "value": "VK_LAYER_KHRONOS_validation" 
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build"
        }
    ]
}